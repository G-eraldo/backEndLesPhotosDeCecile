{
  "kind": "collectionType",
  "collectionName": "produits",
  "info": {
    "singularName": "produit",
    "pluralName": "produits",
    "displayName": "Produit",
    "description": "Tirages et options de la boutique"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titre",
      "required": true
    },
    "accroche": {
      "type": "text"
    },
    "description": {
      "type": "richtext"
    },
    "prix_a_partir_de": {
      "type": "decimal",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "galerie": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "caracteristiques": {
      "type": "component",
      "component": "produit.caracteristique",
      "repeatable": true
    },
    "formats": {
      "type": "json"
    },
    "options": {
      "type": "json"
    },
    "ordre": {
      "type": "integer",
      "default": 0
    },
    "mis_en_avant": {
      "type": "boolean",
      "default": false
    }
  }
}
