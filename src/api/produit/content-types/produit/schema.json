{
  "kind": "collectionType",
  "collectionName": "produits",
  "info": {
    "singularName": "produit",
    "pluralName": "produits",
    "displayName": "Produit",
    "description": "Tirages et options de la boutique"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titre",
      "required": true
    },
    "accroche": {
      "type": "text"
    },
    "description": {
      "type": "richtext"
    },
    "prix_a_partir_de": {
      "type": "decimal",
      "required": true
    },
    "tarifs_formats": {
      "type": "json",
      "description": "Liste des tarifs par format : [{ format: '10 × 15 cm', prix: 3 }]"
    },
    "supplement_bords_franges": {
      "type": "decimal",
      "default": 1,
      "description": "Supplément appliqué pour une finition à bords frangés"
    },
    "supplement_courrier": {
      "type": "decimal",
      "default": 5,
      "description": "Supplément appliqué pour l’envoi postal"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "galerie": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "caracteristiques": {
      "type": "component",
      "component": "produit.caracteristique",
      "repeatable": true
    },
    "formats": {
      "type": "json"
    },
    "options": {
      "type": "json"
    },
    "ordre": {
      "type": "integer",
      "default": 0
    },
    "mis_en_avant": {
      "type": "boolean",
      "default": false
    }
  }
}
